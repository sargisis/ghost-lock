<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  ghost-lock :: DNS Shield (пресет: mullvad)

  Блокирует на уровне DNS: малварь, реклама, трекеры · Mullvad, без логов.

  ServerAddresses — IP самого DoH-сервера (без открытого DNS-запроса).
  Фолбэка на открытый DNS нет (AllowFailover=false): если сеть блокирует
  DoH, интернета не будет — проверь сеть командой dns-check.

  Отключить: Настройки → Основное → VPN и управление устройством → DNS.
-->
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key>
      <string>com.apple.dnsSettings.managed</string>

      <key>DNSSettings</key>
      <dict>
        <key>DNSProtocol</key>
        <string>HTTPS</string>
        <key>ServerURL</key>
        <string>https://base.dns.mullvad.net/dns-query</string>
        <key>ServerAddresses</key>
        <array>
          <string>194.242.2.4</string>
        </array>
        <key>AllowFailover</key>
        <false/>
      </dict>

      <!-- Без супервизии игнорируется; профиль всегда можно снять вручную -->
      <key>ProhibitDisablement</key>
      <false/>

      <key>PayloadDisplayName</key>
      <string>ghost-lock DNS Shield · mullvad</string>
      <key>PayloadIdentifier</key>
      <string>cc.ghostlock.dnsshield</string>
      <key>PayloadUUID</key>
      <string>fc4fdd46-8662-42c1-aa22-e4637bcb2fcf</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
    </dict>
  </array>
  <key>PayloadDescription</key>
  <string>ghost-lock: зашифрованный DNS (DoH), блокировка малварь, реклама, трекеры · Mullvad, без логов. Без фолбэка на открытый DNS.</string>
  <key>PayloadDisplayName</key>
  <string>ghost-lock DNS Shield (mullvad)</string>
  <key>PayloadIdentifier</key>
  <string>cc.ghostlock.dnsshield.profile</string>
  <key>PayloadOrganization</key>
  <string>ghost-lock</string>
  <key>PayloadRemovalDisallowed</key>
  <false/>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>5285d060-b4a6-4801-a404-9b673a40dcaf</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
